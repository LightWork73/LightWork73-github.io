rnet Connection"},description:{unstarted:"We are checking your network speed and stability to prevent interruptions during your assessment.",failed:"The upload speed of your internet does not meet the minimum requirement. Try moving closer to your Wi-Fi or disconnecting other devices on your network.",completed:"Your internet speed meets the requirements to run the assessment smoothly."},minimumUploadSpeedLabel:"Required Upload Speed",uploadSpeedValue:"{{speed}} Mbps",uploadSpeedLabel:"Your Upload Speed",tryAgainButton:"Try Again"},enableGeofence:{title:{unstarted:"Checking Location",notInRadius:"Location Outside Geofence",unknownLocation:"Location Not Detected",completed:"Location Within Geofence"},description:{unstarted:"We are verifying if your current location is within the approved geofence for this assessment.",notInRadius:"Your location is outside the approved geofence for this assessment. You can continue with the assessment.",completed:"Your location is within the approved geofence for this assessment.",noPermission:"Your location could not be detected. Please enable location access in your browser settings, then try again.",unknown:"Your location could not be detected. Please enable location access in both your device and browser settings, then try again."},guide:{title:"Need Help with Enabling Location Access?",description:"Watch the video to learn how to enable location access in your browser and device settings.",video:"How to share location"},tryAgainButton:"Try Again"}},assessmentSetup:{description:"We are checking your browser and screen setup to make sure your assessment is secure.",managedGuestSessionCheck:{title:{unstarted:"Checking Device Account Status",failed:"Device Account Status Not Verified",completed:"Device Account Status Verified"},description:{unstarted:"We are checking your device to ensure that you are logged in with a managed guest session account.",failed:"You are not logged in with the required managed guest session account. Please sign out of your device and log in using the guest session account provided by your institution.",completed:"You are logged in using a managed guest session account."},guideTitle:"Need Help Logging in with Managed Guest Session Account?",guideDescription:"Watch the video to learn how to log in to your device using a managed guest session account.",videoTitle:"How to log into a managed guest session account"},incognitoCheck:{title:{unstarted:"Checking Incognito Mode",failed:"Incognito Mode Not Enabled",completed:"Incognito Mode Enabled"},description:{unstarted:"We are checking your browser setup to ensure incognito mode is enabled for the Verity Browser Extension.",failed:"Incognito mode is not enabled for Verity Browser Extension. Please enable it and refresh the page to try again.",completed:"Incognito mode is enabled for the Verity Browser Extension."},guide:"Watch the video to learn how to enable incognito mode for the Verity Browser Extension.",guideTitle:"Need Help with Enabling Incognito?",videoTitle:"How to enable Incognito Mode",tryAgain:"Try Again"},oneScreenEnforcementMode:{title:{unstarted:"Checking Your Screen Setup",failed:"Multiple Screens Detected",completed:"Screen Setup Ready"},description:{unstarted:"We are checking your screen setup. Only one screen is allowed in this assessment.",failed:"More than one screen was detected. Please unplug any additional monitors and try again.",completed:"Your screen setup is ready for the assessment."}},closeOpenTabs:{title:{unstarted:"Checking Browser Tabs",failed:"Additional Tabs Detected",completed:"All Additional Tabs Closed"},description:{unstarted:"We are checking your browser tabs to ensure no additional tabs are open.",failed:"Some tabs are still open. Please close all additional tabs to continue.",completed:"All additional tabs are closed. You will not be able to open new tabs during your assessment."},closeAllTabsButton:"Close All Tabs"},blockVirtualMachines:{title:{unstarted:"Checking for Virtual Machines",failed:"Virtual Machine Detected",completed:"No Virtual Machines Detected"},description:{unstarted:"We are checking for virtual machines to ensure your device is not running inside a virtual environment.",failed:"Your device is currently running inside a virtual machine. Please close or disconnect it to continue.",completed:"No virtual machines were detected."}},recordApplicationsActivity:{title:{unstarted:"Checking Desktop Application Activities",completed:"Monitoring Desktop Application"},description:{unstarted:"We are checking your device to ensure all applications are closed for your assessment.",completed:"Your desktop application activities are now being monitored. Any time you open or close an application, it will be recorded."}},restrictDevices:{title:{unstarted:"Setting Up Mobile Device Restriction",completed:"Mobile Device Restricted"},description:{unstarted:"We are setting up mobile device restrictions for your assessment. Scan the QR code to turn on Guided Access on your device.",completed:"Guided access is enabled on your mobile device. Your device will have limited access during the assessment."},scanQRCode:"Scan QR Code",guideDescription:"Watch the video to learn how to turn on Guided Access for this restriction.",guideTitle:"Need Help with Setting Up Mobile Device Restriction?",videoTitle:"Setting up Mobile Device Restriction",failToast:"Failed to start restricted device recording"},applicationBlockMode:{title:{unstarted:"Checking for Blocked Applications",failed:"Blocked Applications Detected",completed:"All Blocked Applications Closed"},description:{unstarted:"We are checking for applications that must be closed before your assessment.",failed:"The following applications are open. Please close them or click <b>Force Quit All Applications</b> to continue.",completed:"All blocked applications are closed."},forceQuitButton:"Force Quit All Applications",guide:"If some applications do not close during force quit, you can use Task Manager to end them