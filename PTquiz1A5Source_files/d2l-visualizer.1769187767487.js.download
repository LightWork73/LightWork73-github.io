e;\n}\n\n.common-expandable-banner-text-container {\n    overflow: hidden;\n    line-height: 20px;\n    align-self: center;\n    padding-bottom: 5px;\n    transition: height 0.5s;\n\n    height: 23px;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n\n    @supports (-webkit-line-clamp: 2) {\n        height: 43px;\n        white-space: normal;\n        display: -webkit-box;\n        -webkit-line-clamp: 2;\n        -webkit-box-orient: vertical;\n    }\n}\n\n.common-expandable-banner-text-container.expanded {\n    height: 125px;\n    white-space: normal;\n\n    @supports (-webkit-line-clamp: none) {\n        -webkit-line-clamp: none;\n    }\n}\n\n.common-expandable-banner-bottom-container {\n    display: flex;\n    justify-content: space-between;\n}\n\n.beta-icon-svg {\n    background: url(${m}) no-repeat\n        center;\n    height: 25px;\n    min-width: 40px;\n    align-self: center;\n    background-position: center;\n    background-size: contain;\n}\n\n.server-banner-expand-button {\n    color: #0b6f85;\n    align-self: center;\n    cursor: pointer;\n}\n\n.server-banner-expand-button:focus-visible {\n    outline: 2px solid #0b6f85;\n    outline-offset: 3px;\n    border-radius: 0.5px;\n}\n\n/* commonBanner styles end */\n\n.screen-reader-only {\n    position: absolute;\n    left: -99em;\n    height: 0;\n}\n\n.server-banner {\n    display: flex;\n    font-size: 14px;\n    padding: 8px 5px;\n    gap: 10px;\n    border: 2px solid #0b6f85;\n    border-radius: 8px;\n    background-color: #eefbfe;\n}\n\n.server-banner-icon-container {\n    min-width: 24px;\n    height: 24px;\n    align-self: center;\n}\n\n.server-banner-text-container {\n    align-self: center;\n    line-height: 20px;\n}\n\n.hidden-link {\n    color: #42296e;\n    text-decoration: none;\n    font-weight: 600;\n    margin-right: 10px;\n}\n\n.hidden-link-container svg {\n    transition: transform 0.2s ease-in-out;\n}\n\n.hidden-link:hover {\n    text-decoration: underline;\n}\n\n.hidden-link-contain