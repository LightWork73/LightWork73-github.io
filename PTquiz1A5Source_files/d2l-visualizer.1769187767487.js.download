r-banner-x:hover {\n}\n.server-banner-x.Mui-focusVisible {\n    outline: 2px solid #0b6f85;\n    outline-offset: 3px;\n    border: 0 !important;\n}\n\n.event-banner-container {\n    background: linear-gradient(270deg, #170098, #0d0054);\n    color: white;\n    filter: none;\n}\n\n.event-banner-content {\n    display: flex;\n    flex-direction: row;\n    gap: 5px;\n    align-items: center;\n    padding: 9px;\n}\n\n.event-banner-prefix {\n    margin: 0;\n    font-size: 16px;\n    font-weight: 600;\n    line-height: 1;\n    background-image: linear-gradient(315deg, #dfd1ff, #b2ffff);\n    background-clip: text;\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n}\n\n.event-banner-title {\n    font-size: 16px;\n    color: #efefef;\n    margin-right: 13px;\n}\n.event-banner-link {\n    color: #11007a !important;\n    font-size: 14px !important;\n    align-items: centern;\n    display: flex;\n    flex-direction: row;\n    gap: 6px;\n}\n.banner-stars-start {\n    position: absolute;\n    top: -13px;\n    left: 0px;\n    height: 70px;\n}\n.banner-stars-end {\n    position: absolute;\n    top: -13px;\n    right: 0px;\n    height: 70px;\n}\n\n.event-banner-stars-container {\n    position: absolute;\n    left: 0px;\n    right: 0px;\n    top: 0px;\n    bottom: 0px;\n    display: flex;\n    flex-direction: row;\n    justify-content: space-around;\n    align-items: center;\n}\n\n.common-primary-banner {\n    display: flex;\n    flex-direction: row;\n    gap: 10px;\n    padding: 10px;\n    border-radius: 10px;\n\n    background-color: #f9f8ff;\n    border: 1px solid #c0b9ec;\n\n    color: #333333;\n}\n\n.common-primary-banner > svg {\n    min-width: 24px;\n    transform: scaleX(-100%);\n}\n\n@media (max-width: 680px) {\n    .server-banner-container.expanded {\n        min-width: unset;\n        width: 100%;\n        max-height: unset;\n        height: 150px;\n    }\n    .server-banner-content {\n        flex-direction: column;\n        align-items: flex-start;\n    }\n}\n\n/* ---------- Visualizer Banner on different panels ---------- */\n.server-banner-container button.visualizer-guide-button {\n    min-width: max-content;\n}\n\n.my-content-page-container > .server-banner-container {\n    margin-left: 10px;\n    margin-right: 10px;\n    &.expanded {\n        margin-top: 10px;\n        margin-bottom: 0px;\n    }\n}\n.marketplace-content-container > .server-banner-container {\n    margin-left: 10px;\n    margin-right: 10px;\n    &.expanded {\n        margin-top: 10px;\n        margin-bottom: 10px;\n    }\n}\n.institution-page-content-container:has(.institution-report-container)\n    > .server-banner-container.expanded {\n    margin-bottom: 10px;\n}\n.institution-page-content-container:has(.workflow-page)\n    > .server-banner-container.expanded {\n    margin-top: 10px;\n    margin-bottom: 10px;\n}\n",""]);const s=o},63256:e=>{"use strict";e.exports="data:image/svg+xml;base64,"},63330:(e,t,i)=>{"use strict";i.d(t,{A:()=>o});var n=i(85426),a=i(34563),r=i(80714);const o={isBrowser:!0,classes:{URLSearchParams:n.A,FormData:a.A,Blob:r.A},protocols:["http","https","file","blob","url","data"]}},63361:e=>{"use strict";e.exports="data:image/svg+xml;base64,"},63369:(e,t,i)=>{"use strict";i.d(t,{E:()=>r});var n=i(8818),a=i(34106);function r(e){return(0,a.Ay)("MuiDialogContent",e)}(0,n.A)("MuiDialogContent",["root","dividers"])},63405:e=>{"use strict";e.exports="data:image/svg+xml;base64,"},63417:(e,t,i)=>{"use strict";i.d(t,{fH:()=>n});i(88017),i(86310);function n(){return document.getElementById("main-content")||document.querySelector("main.course-main-content")}},63560:(e,t,i)=>{"use strict";i.d(t,{A:()=>s});var n=i(170),a=i(53669),r=i(24603),o=i(41163);function s(e,t){return(0,n.A)(e)||(0,a.A)(e,t)||(0,r.A)(e,t)||(0,o.A)()}},63620:e=>{"use strict";e.exports="data:image/svg+xml;base64,"},63727:(e,t,i)=>{"use strict";i.d(t,{J8:()=>o,V3:()=>r});var n=i(7951);function a(e){try{if("a"===e.tagName.toLowerCase()&&e.href&&new URL(